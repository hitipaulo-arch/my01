# Exemplo de arquivo .env — NÃO COMITAR suas chaves reais.
# Copie este arquivo para `.env` e preencha os valores reais localmente.
#
# ⚠️  Segredos (SECRET_KEY, WHATSAPP_WEBHOOK_TOKEN/SECRET) devem ser únicos
# por ambiente. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_SECRETA_GENERADA

# ========================================
# GOOGLE SHEETS
# ========================================
GOOGLE_SHEET_ID=SUBSTITUA_PELO_ID_DA_SUA_PLANILHA
GOOGLE_SHEET_TAB=Respostas ao formulário 3
GOOGLE_SHEET_HORARIO_TAB=Controle de Horário
GOOGLE_SHEET_USUARIOS_TAB=Usuários
# Abas adicionais usadas pelo app (criadas automaticamente quando ausentes)
GOOGLE_SHEET_PRODUCAO_TAB=Controle de Produção
GOOGLE_SHEET_CENTRAIS_TAB=Controle de Centrais
GOOGLE_SHEET_FERRAMENTAS_TAB=Controle de Ferramentas
GOOGLE_SHEET_HISTORICO_FERRAMENTAS_TAB=Histórico de Ferramentas

# ========================================
# FLASK / APLICAÇÃO
# ========================================
FLASK_DEBUG=false
# Ambiente: development | production (usado p/ cookies seguros e webhook)
APP_ENV=development
LOG_LEVEL=INFO
# Port (Render configura automaticamente)
PORT=5000

# ========================================
# CACHE
# ========================================
# Deixe CACHE_TYPE vazio para detecção automática (config.py):
#   - RedisCache quando REDIS_URL/REDIS_HOST estiver definido;
#   - SimpleCache (in-memory) caso contrário (ideal p/ dev single-worker).
# Em produção multi-worker (gunicorn -w N) use Redis de verdade.
CACHE_TYPE=

# Configuração do Redis (ativa somente se REDIS_URL/REDIS_HOST definidos)
# REDIS_URL=redis://:senha@host:porta/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
# Prefixo das chaves p/ evitar colisão entre apps no mesmo Redis
CACHE_KEY_PREFIX=my01

# TTLs (em segundos)
CACHE_TTL_SECONDS=300
OS_CACHE_TTL_SECONDS=120
PRODUCAO_CACHE_TTL_SECONDS=30
USUARIOS_CACHE_TTL_SECONDS=300

# Resiliência nas chamadas ao Google Sheets
SHEETS_MAX_RETRIES=3
SHEETS_RETRY_INITIAL_DELAY=0.5
SHEETS_RETRY_BACKOFF=2.0

# ========================================
# NOTIFICAÇÕES — E-MAIL (SMTP)
# ========================================
NOTIFY_ENABLED=false
NOTIFY_TO=seuemail@gmail.com,outro@empresa.com
NOTIFY_FROM=seuemail@gmail.com
# Alternativa/prioridade sobre NOTIFY_TO quando ambos existem
SMTP_RECIPIENTS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=sua_senha_de_app_aqui
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_WORKERS=4

# ========================================
# NOTIFICAÇÕES — WHATSAPP
# ========================================
# WHATSAPP_ENABLED=true liga o serviço Click-to-Chat (links wa.me).
# ⚠️  Ele ABRE o navegador na máquina que roda o app — use true apenas em
# máquina desktop local; em servidores mantenha false.
WHATSAPP_ENABLED=true

# WHATSAPP_WEB_ENABLED liga o envio automático via WhatsApp Web (pywhatkit),
# que exige navegador com WhatsApp Web logado (WHATSAPP_FROM/WHATSAPP_WEB_TO).
WHATSAPP_WEB_ENABLED=false
WHATSAPP_WEB_TO=5511000000000   # Número interno que recebe notificações (só dígitos, com 55)
WHATSAPP_WEB_DELAY_SECONDS=15
WHATSAPP_FROM=5511000000000     # Número logado no WhatsApp Web (pywhatkit)

# ========================================
# WHATSAPP — WEBHOOK (técnicos enviam status/comandos)
# ========================================
WHATSAPP_WEBHOOK_ENABLED=true
WHATSAPP_WEBHOOK_TOKEN=SUBSTITUA_POR_UM_TOKEN_ALEATORIO
# Chave secreta para validar a assinatura HMAC do webhook (MAIS SEGURO)
WHATSAPP_WEBHOOK_SECRET=SUBSTITUA_POR_OUTRO_TOKEN_ALEATORIO
WHATSAPP_WEBHOOK_FROM=5511000000000  # Número autorizado a enviar comandos
WHATSAPP_MAX_PAYLOAD_BYTES=10000

# ========================================
# IA ADMINISTRATIVA (chat /admin/ia)
# ========================================
NVIDIA_API_KEY=SUBSTITUA_PELA_SUA_CHAVE

# ========================================
# USUÁRIOS — FALLBACK LOCAL (apenas desenvolvimento)
# ========================================
# Quando o Google Sheets está indisponível, permite criar um admin local
# a partir das variáveis abaixo (nunca ative em produção).
ALLOW_LOCAL_ADMIN_FALLBACK=false
LOCAL_ADMIN_USER=
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_ROLE=admin

# ========================================
# VALIDAÇÃO DE ITENS
# ========================================
ITEM_ALERT_THRESHOLD=10
