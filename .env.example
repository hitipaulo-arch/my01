# Exemplo de arquivo .env — NÃO COMITAR suas chaves reais.
# Copie este arquivo para `.env` e preencha os valores reais localmente.

SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_SECRETA_GENERADA

# Google Sheets Configuration
GOOGLE_SHEET_ID=1qs3cxlklTnzCp4RpQGhxIrEF4CbeUvid1S0Cp2tC3Xg
GOOGLE_SHEET_TAB=Respostas ao formulário 3
GOOGLE_SHEET_HORARIO_TAB=Controle de Horário
GOOGLE_SHEET_USUARIOS_TAB=Usuários

# Flask Configuration
FLASK_DEBUG=false
APP_ENV=development
LOG_LEVEL=INFO

# AI Configuration
# Escolha um provedor: nvidia, openai, ollama
# Recomenda-se usar Ollama local gratuitamente em desenvolvimento.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b
NVIDIA_API_KEY=sua_chave_nvidia
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
OPENAI_API_KEY=sua_chave_openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:3b

# Cache Configuration (em segundos)
CACHE_TTL_SECONDS=300

# Tipo de cache: 'RedisCache' (produção multi-worker) ou 'SimpleCache' (dev single-worker).
# Se REDIS_URL estiver definido, o padrão é RedisCache automaticamente.
CACHE_TYPE=RedisCache

# ========================================
# REDIS (recomendado em produção com gunicorn multi-worker)
# ========================================
# URL completa do Redis (tem prioridade sobre REDIS_HOST/PORT/DB/PASSWORD)
# Formato: redis://[:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# Configuração alternativa (usada se REDIS_URL não estiver definido)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# TTLs específicos por tipo de dado (em segundos)
OS_CACHE_TTL_SECONDS=120
PRODUCAO_CACHE_TTL_SECONDS=30
USUARIOS_CACHE_TTL_SECONDS=300

# Port (Render configura automaticamente)
PORT=5000

# ========================================
# NOTIFICAÇÕES (OPCIONAIS)
# ========================================

# --- E-mail (SMTP) ---
# Ativa notificação por e-mail ao abrir OS
NOTIFY_ENABLED=false
NOTIFY_TO=seuemail@gmail.com,outro@empresa.com
NOTIFY_FROM=seuemail@gmail.com

# Configuração Gmail (exemplo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=sua_senha_de_app_aqui
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# --- WhatsApp (Click-to-Chat e Webhook) ---
# Ativa notificação por WhatsApp ao abrir OS (sem Twilio)
WHATSAPP_ENABLED=true

# --- WhatsApp Web (pywhatkit) ---
# Ativa o envio automático de mensagens via WhatsApp Web (requer navegador logado)
WHATSAPP_WEB_ENABLED=false
WHATSAPP_WEB_TO=5512982200009 # Número para receber notificações de novas OS

# Webhook para receber mensagens via WhatsApp
# Permite técnicos enviar status/comandos via WhatsApp
WHATSAPP_WEBHOOK_ENABLED=true
WHATSAPP_WEBHOOK_TOKEN=gere_um_token_e_cole_aqui # Ex: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Chave secreta para validar a assinatura HMAC do webhook (MAIS SEGURO)
# O provedor (ex: Meta) usará esta chave para assinar as requisições.
WHATSAPP_WEBHOOK_SECRET=QBxQW3lFFcMqGvezQEZJvkVhA-VkPMeUVJqJi9ECn9I
WHATSAPP_WEBHOOK_FROM=5512982200009  # Número autorizado a enviar comandos
